# Copy this file to .env and fill in your values.

# Your Google Cloud project (used for the hosted Gemini comparison and TPU commands)
GCP_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global

# vLLM endpoint on the TPU (reached through an SSH tunnel)
VLLM_API_BASE=http://127.0.0.1:8000/v1
TPU_MODEL=google/gemma-3-4b-it
